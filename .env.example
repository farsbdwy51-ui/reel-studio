# كل القيم دي اختيارية — ممكن تظبطها من شاشة الإعدادات جوه التطبيق
# وكل base URL ممكن يتبدل بأي سيرفيس متوافق

# FreeLLMAPI أو أي OpenAI-compatible endpoint
FREELLM_BASE_URL=http://127.0.0.1:31415/v1
LLM_MODEL=auto

# ElevenLabs (صوت) — https://elevenlabs.io/app/developers/
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Deepgram (توقيت الكلمات لصوت مرفوع) — https://console.deepgram.com/
DEEPGRAM_BASE_URL=https://api.deepgram.com
DEEPGRAM_API_KEY=

# فولدر خط بديل (اختياري)
FONT_FOLDER=

# البورت
PORT=4301
